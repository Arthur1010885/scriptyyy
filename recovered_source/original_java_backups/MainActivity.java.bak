package com.s;

import android.app.Activity;
import android.content.Intent;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.graphics.drawable.RippleDrawable;
import android.content.res.ColorStateList;
import android.net.Uri;
import android.os.Build;
import android.os.Bundle;
import android.provider.Settings;
import android.util.TypedValue;
import android.view.Gravity;
import android.view.View;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.TextView;

public class MainActivity extends Activity {

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        final int BG = Color.parseColor("#0E0E10");
        final int CARD = Color.parseColor("#141417");
        final int TEXT = Color.parseColor("#F5F5F7");
        final int MUTED = Color.parseColor("#6E6E76");
        final int ACCENT = Color.parseColor("#3B82F6");

        FrameLayout root = new FrameLayout(this);
        root.setBackgroundColor(BG);

        LinearLayout card = new LinearLayout(this);
        card.setOrientation(LinearLayout.VERTICAL);
        card.setGravity(Gravity.CENTER_HORIZONTAL);
        card.setPadding(dp(28), dp(28), dp(28), dp(28));
        GradientDrawable cardBg = new GradientDrawable();
        cardBg.setColor(CARD);
        cardBg.setCornerRadius(dp(24));
        cardBg.setStroke(dp(1), Color.parseColor("#23232A"));
        card.setBackground(cardBg);
        card.setElevation(dp(8));

        // Logo
        OverlayService.LogoView logo = new OverlayService.LogoView(this);
        FrameLayout.LayoutParams logoLp = new FrameLayout.LayoutParams(dp(84), dp(84));
        LinearLayout.LayoutParams lLp = new LinearLayout.LayoutParams(dp(84), dp(84));
        lLp.bottomMargin = dp(16);
        card.addView(logo, lLp);

        TextView title = new TextView(this);
        title.setText("      ONIONDLC");
        title.setTextColor(TEXT);
        title.setTypeface(Typeface.DEFAULT_BOLD);
        title.setLetterSpacing(0.06f);
        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 28);
        card.addView(title);

        TextView sub = new TextView(this);
        sub.setText("STANDOFF 2  •  0.38.1");
        sub.setTextColor(MUTED);
        sub.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
        sub.setLetterSpacing(0.12f);
        LinearLayout.LayoutParams subLp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.WRAP_CONTENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
        subLp.topMargin = dp(6);
        subLp.bottomMargin = dp(28);
        sub.setLayoutParams(subLp);
        card.addView(sub);

        // START button
        TextView startBtn = new TextView(this);
        startBtn.setText("START");
        startBtn.setTextColor(Color.WHITE);
        startBtn.setTypeface(Typeface.DEFAULT_BOLD);
        startBtn.setLetterSpacing(0.18f);
        startBtn.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
        startBtn.setGravity(Gravity.CENTER);
        startBtn.setPadding(dp(40), dp(14), dp(40), dp(14));
        GradientDrawable btnBg = new GradientDrawable();
        btnBg.setColor(ACCENT);
        btnBg.setCornerRadius(dp(999));
        RippleDrawable ripple = new RippleDrawable(
                ColorStateList.valueOf(Color.parseColor("#66FFFFFF")), btnBg, null);
        startBtn.setBackground(ripple);
        startBtn.setClickable(true);
        startBtn.setFocusable(true);
        LinearLayout.LayoutParams bLp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.WRAP_CONTENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
        card.addView(startBtn, bLp);

        TextView hint = new TextView(this);
        hint.setText("");
        hint.setTextColor(MUTED);
        hint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 11);
        hint.setGravity(Gravity.CENTER);
        LinearLayout.LayoutParams hLp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.WRAP_CONTENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
        hLp.topMargin = dp(18);
        card.addView(hint, hLp);

        FrameLayout.LayoutParams cardLp = new FrameLayout.LayoutParams(
                dp(300), FrameLayout.LayoutParams.WRAP_CONTENT);
        cardLp.gravity = Gravity.CENTER;
        root.addView(card, cardLp);

        setContentView(root);

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
            if (!Settings.canDrawOverlays(this)) {
                Intent intent = new Intent(
                        Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                        Uri.parse("package:" + getPackageName()));
                startActivity(intent);
            }
        }

        startBtn.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Intent service = new Intent(MainActivity.this, OverlayService.class);
                startService(service);
                Intent game = getPackageManager().getLaunchIntentForPackage("com.axlebolt.standoff2");
                if (game != null) startActivity(game);
            }
        });
    }

    private int dp(int v) {
        return Math.round(v * getResources().getDisplayMetrics().density);
    }
}
