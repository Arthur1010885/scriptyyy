package com.s;

import android.animation.ValueAnimator;
import android.app.Service;
import android.content.Context;
import android.content.Intent;
import android.graphics.Canvas;
import android.graphics.Color;
import android.graphics.LinearGradient;
import android.graphics.Paint;
import android.graphics.Path;
import android.graphics.PixelFormat;
import android.graphics.RectF;
import android.graphics.Shader;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.os.IBinder;
import android.util.TypedValue;
import android.view.Gravity;
import android.view.MotionEvent;
import android.view.View;
import android.view.WindowManager;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

public class OverlayService extends Service {

    private WindowManager windowManager;
    private FrameLayout menu;
    private View bubble;
    private WindowManager.LayoutParams menuParams;
    private WindowManager.LayoutParams bubbleParams;

    // Selected tab (0=AIM, 1=ESP, 2=MAIN, 3=BAN)
    private int activeTab = 0;
    private LinearLayout sidebar;
    private FrameLayout contentHolder;

    // Palette
    private static final int COL_BG       = Color.parseColor("#0E0E10");
    private static final int COL_CARD     = Color.parseColor("#1A1A1F");
    private static final int COL_DIVIDER  = Color.parseColor("#232328");
    private static final int COL_TEXT     = Color.parseColor("#F5F5F7");
    private static final int COL_MUTED    = Color.parseColor("#6E6E76");

    private static final String[] TABS = {"AIM", "ESP", "MAIN", "BAN"};

    @Override public IBinder onBind(Intent intent) { return null; }

    @Override
    public void onCreate() {
        super.onCreate();
        windowManager = (WindowManager) getSystemService(WINDOW_SERVICE);

        menu = buildMenu(this);
        menuParams = new WindowManager.LayoutParams(
                dp(340), dp(340),
                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
                PixelFormat.TRANSLUCENT);
        menuParams.gravity = Gravity.TOP | Gravity.LEFT;
        menuParams.x = dp(16);
        menuParams.y = dp(48);
        attachDrag(menu, menuParams, true);
        windowManager.addView(menu, menuParams);
    }

    @Override
    public void onDestroy() {
        super.onDestroy();
        safeRemove(menu);
        safeRemove(bubble);
        menu = null;
        bubble = null;
    }

    private void safeRemove(View v) {
        if (v != null && windowManager != null) {
            try { windowManager.removeView(v); } catch (Exception ignored) {}
        }
    }

    // ===== Open / Close =====

    private void closeMenu() {
        safeRemove(menu);
        showBubble();
    }

    private void showBubble() {
        bubble = buildBubble(this);
        bubbleParams = new WindowManager.LayoutParams(
                dp(44), dp(44),
                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
                PixelFormat.TRANSLUCENT);
        bubbleParams.gravity = Gravity.TOP | Gravity.LEFT;
        bubbleParams.x = menuParams.x;
        bubbleParams.y = menuParams.y;
        attachDrag(bubble, bubbleParams, false);
        windowManager.addView(bubble, bubbleParams);
    }

    private void openMenu() {
        if (bubble != null) {
            menuParams.x = bubbleParams.x;
            menuParams.y = bubbleParams.y;
            safeRemove(bubble);
            bubble = null;
        }
        windowManager.addView(menu, menuParams);
    }

    // ===== Drag handling =====

    private void attachDrag(final View target, final WindowManager.LayoutParams params,
                            final boolean isMenu) {
        target.setOnTouchListener(new View.OnTouchListener() {
            int sx, sy; float tx, ty; boolean moved;
            @Override public boolean onTouch(View v, MotionEvent e) {
                switch (e.getAction()) {
                    case MotionEvent.ACTION_DOWN:
                        sx = params.x; sy = params.y;
                        tx = e.getRawX(); ty = e.getRawY();
                        moved = false;
                        return true;
                    case MotionEvent.ACTION_MOVE:
                        int nx = sx + (int)(e.getRawX() - tx);
                        int ny = sy + (int)(e.getRawY() - ty);
                        if (Math.abs(nx - sx) > dp(4) || Math.abs(ny - sy) > dp(4)) moved = true;
                        params.x = nx; params.y = ny;
                        windowManager.updateViewLayout(target, params);
                        return true;
                    case MotionEvent.ACTION_UP:
                        if (!moved && !isMenu) openMenu();
                        return true;
                }
                return false;
            }
        });
    }

    // ===== UI: floating bubble =====

    private View buildBubble(Context ctx) {
        FrameLayout f = new FrameLayout(ctx);
        f.setElevation(dp(10));
        LogoView logo = new LogoView(ctx);
        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT);
        f.addView(logo, lp);
        return f;
    }

    // ===== UI: menu =====

    private FrameLayout buildMenu(Context ctx) {
        FrameLayout root = new FrameLayout(ctx);
        GradientDrawable bg = new GradientDrawable();
        bg.setColor(COL_BG);
        bg.setCornerRadius(dp(20));
        bg.setStroke(dp(1), Color.parseColor("#23232A"));
        root.setBackground(bg);
        root.setClipToOutline(true);
        root.setElevation(dp(10));

        LinearLayout col = new LinearLayout(ctx);
        col.setOrientation(LinearLayout.VERTICAL);
        col.setLayoutParams(new FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT));
        col.addView(buildHeader(ctx));
        col.addView(buildDivider(ctx));
        col.addView(buildBody(ctx));
        root.addView(col);

        // Close (×) button — top-right corner
        View close = buildCloseButton(ctx);
        FrameLayout.LayoutParams cp = new FrameLayout.LayoutParams(dp(22), dp(22));
        cp.gravity = Gravity.TOP | Gravity.END;
        cp.topMargin = dp(8);
        cp.rightMargin = dp(8);
        root.addView(close, cp);

        return root;
    }

    private View buildCloseButton(Context ctx) {
        FrameLayout btn = new FrameLayout(ctx);
        GradientDrawable g = new GradientDrawable();
        g.setShape(GradientDrawable.OVAL);
        g.setColor(Color.parseColor("#1A1A1F"));
        g.setStroke(dp(1), Color.parseColor("#2A2A30"));
        btn.setBackground(g);
        btn.setClickable(true);
        btn.setFocusable(true);

        CrossView cross = new CrossView(ctx);
        FrameLayout.LayoutParams cp = new FrameLayout.LayoutParams(dp(10), dp(10));
        cp.gravity = Gravity.CENTER;
        btn.addView(cross, cp);

        btn.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View v) { closeMenu(); }
        });
        // Stop drag from capturing tap on the close button
        btn.setOnTouchListener(new View.OnTouchListener() {
            @Override public boolean onTouch(View v, MotionEvent e) { return false; }
        });
        return btn;
    }

    private View buildHeader(Context ctx) {
        LinearLayout h = new LinearLayout(ctx);
        h.setOrientation(LinearLayout.HORIZONTAL);
        h.setGravity(Gravity.CENTER_VERTICAL);
        h.setPadding(dp(12), dp(10), dp(36), dp(10)); // reserve space for close btn

        LogoView logo = new LogoView(ctx);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(dp(32), dp(32));
        lp.rightMargin = dp(9);
        h.addView(logo, lp);

        LinearLayout left = new LinearLayout(ctx);
        left.setOrientation(LinearLayout.VERTICAL);
        TextView t1 = new TextView(ctx);
        t1.setText("ONIONDLC");
        t1.setTextColor(COL_TEXT);
        t1.setTypeface(Typeface.DEFAULT_BOLD);
        t1.setLetterSpacing(0.04f);
        t1.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
        TextView t2 = new TextView(ctx);
        t2.setText("t.me/oniondlc");
        t2.setTextColor(COL_MUTED);
        t2.setTextSize(TypedValue.COMPLEX_UNIT_SP, 9);
        left.addView(t1);
        left.addView(t2);
        h.addView(left, new LinearLayout.LayoutParams(0,
                LinearLayout.LayoutParams.WRAP_CONTENT, 1f));

        LinearLayout right = new LinearLayout(ctx);
        right.setOrientation(LinearLayout.VERTICAL);
        right.setGravity(Gravity.END);
        TextView r1 = new TextView(ctx);
        r1.setText("STANDOFF 2");
        r1.setTextColor(COL_TEXT);
        r1.setTypeface(Typeface.DEFAULT_BOLD);
        r1.setLetterSpacing(0.04f);
        r1.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
        r1.setGravity(Gravity.END);
        TextView r2 = new TextView(ctx);
        r2.setText("0.38.1");
        r2.setTextColor(COL_MUTED);
        r2.setTextSize(TypedValue.COMPLEX_UNIT_SP, 9);
        r2.setGravity(Gravity.END);
        right.addView(r1);
        right.addView(r2);
        h.addView(right);
        return h;
    }

    private View buildDivider(Context ctx) {
        View v = new View(ctx);
        v.setBackgroundColor(COL_DIVIDER);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, dp(1));
        lp.leftMargin = dp(12); lp.rightMargin = dp(12);
        v.setLayoutParams(lp);
        return v;
    }

    private View buildBody(Context ctx) {
        LinearLayout body = new LinearLayout(ctx);
        body.setOrientation(LinearLayout.HORIZONTAL);
        body.setLayoutParams(new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, 0, 1f));

        sidebar = buildSidebar(ctx);
        body.addView(sidebar);

        contentHolder = new FrameLayout(ctx);
        contentHolder.setLayoutParams(new LinearLayout.LayoutParams(0,
                LinearLayout.LayoutParams.MATCH_PARENT, 1f));
        body.addView(contentHolder);

        renderContent(ctx);
        return body;
    }

    private LinearLayout buildSidebar(final Context ctx) {
        LinearLayout side = new LinearLayout(ctx);
        side.setOrientation(LinearLayout.VERTICAL);
        side.setGravity(Gravity.CENTER_HORIZONTAL);
        side.setPadding(dp(6), dp(12), dp(6), dp(12));
        side.setLayoutParams(new LinearLayout.LayoutParams(dp(60),
                LinearLayout.LayoutParams.MATCH_PARENT));

        for (int i = 0; i < TABS.length; i++) {
            final int idx = i;
            View tab = buildSideTab(ctx, TABS[i], i == activeTab);
            tab.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View v) {
                    if (activeTab == idx) return;
                    activeTab = idx;
                    refreshSidebar(ctx);
                    renderContent(ctx);
                }
            });
            side.addView(tab);
        }
        return side;
    }

    private void refreshSidebar(Context ctx) {
        sidebar.removeAllViews();
        for (int i = 0; i < TABS.length; i++) {
            final int idx = i;
            View tab = buildSideTab(ctx, TABS[i], i == activeTab);
            tab.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View v) {
                    if (activeTab == idx) return;
                    activeTab = idx;
                    refreshSidebar(v.getContext());
                    renderContent(v.getContext());
                }
            });
            sidebar.addView(tab);
        }
    }

    private View buildSideTab(Context ctx, String label, boolean active) {
        LinearLayout tab = new LinearLayout(ctx);
        tab.setOrientation(LinearLayout.VERTICAL);
        tab.setGravity(Gravity.CENTER);
        tab.setClickable(true);
        tab.setFocusable(true);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
        lp.bottomMargin = dp(10);
        tab.setLayoutParams(lp);

        FrameLayout box = new FrameLayout(ctx);
        box.setLayoutParams(new LinearLayout.LayoutParams(dp(42), dp(42)));
        if (active) {
            GradientDrawable g = new GradientDrawable();
            g.setColor(COL_CARD);
            g.setCornerRadius(dp(11));
            g.setStroke(dp(1), Color.parseColor("#2A2A30"));
            box.setBackground(g);
        }
        IconView icon = new IconView(ctx, label, active);
        FrameLayout.LayoutParams ip = new FrameLayout.LayoutParams(dp(20), dp(20));
        ip.gravity = Gravity.CENTER;
        box.addView(icon, ip);
        tab.addView(box);

        TextView t = new TextView(ctx);
        t.setText(label);
        t.setTextColor(active ? COL_TEXT : COL_MUTED);
        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 9);
        t.setLetterSpacing(0.12f);
        t.setTypeface(Typeface.DEFAULT_BOLD);
        LinearLayout.LayoutParams tlp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.WRAP_CONTENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
        tlp.topMargin = dp(4);
        t.setLayoutParams(tlp);
        tab.addView(t);
        return tab;
    }

    // ===== Tab content =====

    private void renderContent(Context ctx) {
        contentHolder.removeAllViews();
        contentHolder.addView(buildContent(ctx, activeTab));
    }

    private View buildContent(Context ctx, int tab) {
        LinearLayout container = new LinearLayout(ctx);
        container.setOrientation(LinearLayout.VERTICAL);
        container.setPadding(dp(6), dp(10), dp(12), dp(10));
        container.setLayoutParams(new FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT));

        TextView section = new TextView(ctx);
        section.setText(sectionTitle(tab));
        section.setTextColor(COL_MUTED);
        section.setTextSize(TypedValue.COMPLEX_UNIT_SP, 9);
        section.setLetterSpacing(0.18f);
        section.setTypeface(Typeface.DEFAULT_BOLD);
        LinearLayout.LayoutParams sp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.WRAP_CONTENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
        sp.bottomMargin = dp(4);
        section.setLayoutParams(sp);
        container.addView(section);

        ScrollView scroll = new ScrollView(ctx);
        scroll.setVerticalScrollBarEnabled(true);
        scroll.setVerticalFadingEdgeEnabled(true);
        scroll.setFadingEdgeLength(dp(16));
        scroll.setOverScrollMode(View.OVER_SCROLL_NEVER);
        LinearLayout list = new LinearLayout(ctx);
        list.setOrientation(LinearLayout.VERTICAL);

        String[][] data = items(tab);
        for (int i = 0; i < data.length; i++) {
            list.addView(buildToggleRow(ctx, data[i][0], data[i][1]));
            if (i < data.length - 1) list.addView(buildRowDivider(ctx));
        }
        scroll.addView(list);
        scroll.setLayoutParams(new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, 0, 1f));
        container.addView(scroll);
        return container;
    }

