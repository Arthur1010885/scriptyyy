}
    private View buildToggleRow(Context ctx, String title, String sub) {
        LinearLayout row = new LinearLayout(ctx);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setGravity(Gravity.CENTER_VERTICAL);
        row.setPadding(dp(6), dp(8), dp(2), dp(8));

        LinearLayout texts = new LinearLayout(ctx);
        texts.setOrientation(LinearLayout.VERTICAL);
        TextView a = new TextView(ctx);
        a.setText(title);
        a.setTextColor(COL_TEXT);
        a.setTypeface(Typeface.DEFAULT_BOLD);
        a.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
        TextView b = new TextView(ctx);
        b.setText(sub);
        b.setTextColor(COL_MUTED);
        b.setTextSize(TypedValue.COMPLEX_UNIT_SP, 10);
        texts.addView(a);
        texts.addView(b);
        row.addView(texts, new LinearLayout.LayoutParams(0,
                LinearLayout.LayoutParams.WRAP_CONTENT, 1f));

        ToggleView toggle = new ToggleView(ctx);
        row.addView(toggle, new LinearLayout.LayoutParams(dp(38), dp(22)));
        return row;
    }

    private View buildRowDivider(Context ctx) {
        View v = new View(ctx);
        v.setBackgroundColor(COL_DIVIDER);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, dp(1));
        lp.leftMargin = dp(8); lp.rightMargin = dp(4);
        v.setLayoutParams(lp);
        return v;
    }

    private int dp(int v) {
        return Math.round(v * getResources().getDisplayMetrics().density);
    }

    // ===== Custom views =====

    /** Circular logo with diagonal blue/black split and "ONIONDLC" caption. */
    public static class LogoView extends View {
        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
        private final Paint text  = new Paint(Paint.ANTI_ALIAS_FLAG);
        private final Path clip   = new Path();
        public LogoView(Context c) { super(c); text.setColor(Color.WHITE); text.setFakeBoldText(true); }
        @Override protected void onDraw(Canvas canvas) {
            int w = getWidth(), h = getHeight();
            float r = Math.min(w, h) / 2f;
            float cx = w / 2f, cy = h / 2f;
            clip.reset();
            clip.addCircle(cx, cy, r, Path.Direction.CW);
            canvas.save();
            canvas.clipPath(clip);
            paint.setColor(Color.parseColor("#0A0A0C"));
            canvas.drawRect(0, 0, w, h, paint);
            paint.setShader(new LinearGradient(0, h, w, 0,
                    Color.parseColor("#1E40AF"), Color.parseColor("#3B82F6"),
                    Shader.TileMode.CLAMP));
            Path tri = new Path();
            tri.moveTo(w, 0);
            tri.lineTo(w, h);
            tri.lineTo(0, h);
            tri.close();
            canvas.drawPath(tri, paint);
            paint.setShader(null);
            paint.setColor(Color.WHITE);
            paint.setStrokeWidth(2f);
            canvas.drawLine(0, h, w, 0, paint);
            text.setTextSize(r * 0.36f);
            text.setTextAlign(Paint.Align.CENTER);
            canvas.drawText("ONIONDLC", cx, cy + text.getTextSize() / 3f, text);
            canvas.restore();
            paint.setStyle(Paint.Style.STROKE);
            paint.setStrokeWidth(1.5f);
            paint.setColor(Color.parseColor("#2A2A30"));
            canvas.drawCircle(cx, cy, r - 1, paint);
            paint.setStyle(Paint.Style.FILL);
        }
    }

    /** Small "×" cross icon. */
    public static class CrossView extends View {
        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
        public CrossView(Context c) {
            super(c);
            p.setColor(Color.parseColor("#C8C8CE"));
            p.setStyle(Paint.Style.STROKE);
            p.setStrokeCap(Paint.Cap.ROUND);
        }
        @Override protected void onDraw(Canvas canvas) {
            float w = getWidth(), h = getHeight();
            p.setStrokeWidth(Math.max(2f, w * 0.14f));
            float pad = w * 0.18f;
            canvas.drawLine(pad, pad, w - pad, h - pad, p);
            canvas.drawLine(w - pad, pad, pad, h - pad, p);
        }
    }

    /** Monochrome icon renderer for AIM / ESP / MAIN / BAN. */
    public static class IconView extends View {
        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
        private final String kind;
        public IconView(Context c, String kind, boolean active) {
            super(c);
            this.kind = kind;
            p.setColor(active ? Color.parseColor("#F2F2F5") : Color.parseColor("#9A9AA2"));
            p.setStyle(Paint.Style.STROKE);
        }
        @Override protected void onDraw(Canvas canvas) {
            float w = getWidth(), h = getHeight();
            float cx = w/2f, cy = h/2f;
            float r = Math.min(w, h)/2f - 2f;
            p.setStrokeWidth(Math.max(2f, w*0.08f));
            p.setStrokeCap(Paint.Cap.ROUND);
            p.setStrokeJoin(Paint.Join.ROUND);
            p.setStyle(Paint.Style.STROKE);
            switch (kind) {
                case "AIM": {
                    canvas.drawCircle(cx, cy, r*0.85f, p);
                    canvas.drawCircle(cx, cy, r*0.35f, p);
                    canvas.drawLine(cx, cy - r, cx, cy - r*0.55f, p);
                    canvas.drawLine(cx, cy + r*0.55f, cx, cy + r, p);
                    canvas.drawLine(cx - r, cy, cx - r*0.55f, cy, p);
                    canvas.drawLine(cx + r*0.55f, cy, cx + r, cy, p);
                    break;
                }
                case "ESP": {
                    Path eye = new Path();
                    eye.moveTo(cx - r, cy);
                    eye.quadTo(cx, cy - r*0.95f, cx + r, cy);
                    eye.quadTo(cx, cy + r*0.95f, cx - r, cy);
                    eye.close();
                    canvas.drawPath(eye, p);
                    p.setStyle(Paint.Style.FILL);
                    canvas.drawCircle(cx, cy, r*0.28f, p);
                    p.setStyle(Paint.Style.STROKE);
                    break;
                }
                case "MAIN": {
                    Path house = new Path();
                    house.moveTo(cx - r, cy);
                    house.lineTo(cx, cy - r*0.9f);
                    house.lineTo(cx + r, cy);
                    canvas.drawPath(house, p);
                    canvas.drawRect(cx - r*0.78f, cy - r*0.12f, cx + r*0.78f, cy + r*0.85f, p);
                    canvas.drawRect(cx - r*0.22f, cy + r*0.25f, cx + r*0.22f, cy + r*0.85f, p);
                    break;
                }
                case "BAN": {
                    Path shield = new Path();
                    shield.moveTo(cx, cy - r);
                    shield.lineTo(cx + r*0.85f, cy - r*0.55f);
                    shield.lineTo(cx + r*0.85f, cy + r*0.15f);
                    shield.quadTo(cx, cy + r*1.05f, cx - r*0.85f, cy + r*0.15f);
                    shield.lineTo(cx - r*0.85f, cy - r*0.55f);
                    shield.close();
                    canvas.drawPath(shield, p);
                    break;
                }
            }
        }
    }

    /** Pill toggle switch. */
    public static class ToggleView extends View {
        private boolean on = false;
        private float prog = 0f;
        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
        private final RectF r = new RectF();

        public ToggleView(Context c) {
            super(c);
            setClickable(true);
            setOnClickListener(new OnClickListener() {
                @Override public void onClick(View v) { toggle(); }
            });
        }

        private void toggle() {
            on = !on;
            ValueAnimator a = ValueAnimator.ofFloat(prog, on ? 1f : 0f);
            a.setDuration(180);
            a.addUpdateListener(new ValueAnimator.AnimatorUpdateListener() {
                @Override public void onAnimationUpdate(ValueAnimator anim) {
                    prog = (float) anim.getAnimatedValue();
                    invalidate();
                }
            });
            a.start();
        }

        @Override protected void onDraw(Canvas canvas) {
            float w = getWidth(), h = getHeight();
            r.set(0, 0, w, h);
            int trackOff = Color.parseColor("#1E1E22");
            int trackOn  = Color.parseColor("#1F3A6B");
            p.setColor(blend(trackOff, trackOn, prog));
            canvas.drawRoundRect(r, h/2f, h/2f, p);
            p.setStyle(Paint.Style.STROKE);
            p.setStrokeWidth(1f);
            p.setColor(Color.parseColor("#2A2A30"));
            r.inset(0.5f, 0.5f);
            canvas.drawRoundRect(r, h/2f, h/2f, p);
            p.setStyle(Paint.Style.FILL);
            r.inset(-0.5f, -0.5f);
            float pad = h * 0.18f;
            float thumbR = (h - pad*2) / 2f;
            float cx = pad + thumbR + (w - pad*2 - thumbR*2) * prog;
            float cy = h / 2f;
            p.setColor(Color.parseColor("#00000055"));
            canvas.drawCircle(cx, cy + 1.5f, thumbR, p);
            int thumbOff = Color.parseColor("#9A9AA2");
            int thumbOn  = Color.parseColor("#E6E6EA");
            p.setColor(blend(thumbOff, thumbOn, prog));
            canvas.drawCircle(cx, cy, thumbR, p);
        }

        private int blend(int a, int b, float t) {
            int ar = (a>>16)&0xff, ag=(a>>8)&0xff, ab=a&0xff;
            int br = (b>>16)&0xff, bg=(b>>8)&0xff, bb=b&0xff;
            int rr = (int)(ar + (br-ar)*t);
            int gg = (int)(ag + (bg-ag)*t);
            int bb2= (int)(ab + (bb-ab)*t);
            return 0xff000000 | (rr<<16) | (gg<<8) | bb2;
        }
    }
}
